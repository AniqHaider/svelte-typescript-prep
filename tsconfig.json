{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"strict": true,
		"types": ["bun"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "scripts/**/*.ts"]
}
